<Application
    x:Class="SPPAudioStudio.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AccentColor">#6670F6</Color>
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E6EF"/>
            <SolidColorBrush x:Key="MutedBrush" Color="#697386"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
